# Released Configuration
# Copy this file to .env and fill in your actual values.
# Variable names follow the target's setting keys; run `target-released --about`
# for the authoritative list.

# Required: Long-lived Bearer access token for the Released API
TARGET_RELEASED_ACCESS_TOKEN=your_access_token_here

# Required: Company ID used when creating contacts and related records
TARGET_RELEASED_COMPANY_ID=your_company_id_here

# Optional: API base URL (defaults to https://api.re-leased.com/api)
TARGET_RELEASED_API_URL=https://api.re-leased.com/api
